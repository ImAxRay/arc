<?xml version="1.0" encoding="utf-8"?>
<!-- Buttons sit in the middle: launchers such as Niagara keep the right edge for their own slider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/arc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/arc_widget_ground"
    android:clipToOutline="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="14dp">

        <ImageView
            android:id="@+id/arc_cover"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:contentDescription="@string/album_art"
            android:scaleType="centerCrop"
            android:src="@drawable/arc_widget_blank" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/arc_label"
                style="@style/ArcWidgetLabel"
                android:layout_width="match_parent"
                android:text="@string/arc_widget_name" />

            <TextView
                android:id="@+id/arc_title"
                style="@style/ArcWidgetTitle"
                android:layout_marginTop="2dp"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/arc_artist"
                style="@style/ArcWidgetArtist"
                android:textSize="13sp" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/arc_time"
            style="@style/ArcWidgetCounter"
            android:layout_width="wrap_content"
            android:textSize="34sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/arc_line"
        style="@style/ArcWidgetLine"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:minHeight="56dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/arc_prev"
            style="@style/ArcWidgetSkip"
            android:contentDescription="@string/previous"
            android:src="@drawable/arc_widget_prev" />

        <FrameLayout
            android:id="@+id/arc_play"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/arc_widget_disc"
            android:contentDescription="@string/play_pause">

            <ImageView
                android:id="@+id/arc_play_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/arc_widget_play" />
        </FrameLayout>

        <ImageView
            android:id="@+id/arc_next"
            style="@style/ArcWidgetSkip"
            android:contentDescription="@string/next"
            android:src="@drawable/arc_widget_next" />
    </LinearLayout>
</LinearLayout>
