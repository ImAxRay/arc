<?xml version="1.0" encoding="utf-8"?>
<!-- The record hangs off the right edge and takes no taps there; the buttons sit on the left. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/arc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/arc_widget_ground"
    android:clipToOutline="true">

    <FrameLayout
        android:id="@+id/arc_vinyl"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="-48dp">

        <ImageView
            android:id="@+id/arc_vinyl_still"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/arc_widget_vinyl" />

        <ProgressBar
            android:id="@+id/arc_vinyl_spin"
            style="@style/ArcWidgetSpin"
            android:indeterminateDrawable="@drawable/arc_widget_vinyl_spin"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/arc_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="53dp"
            android:contentDescription="@string/album_art"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/arc_vinyl_label_still"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/arc_widget_vinyl_label" />

        <ProgressBar
            android:id="@+id/arc_vinyl_label_spin"
            style="@style/ArcWidgetSpin"
            android:indeterminateDrawable="@drawable/arc_widget_vinyl_label_spin"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/arc_vinyl_info"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="130dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/arc_label"
            style="@style/ArcWidgetLabel"
            android:layout_width="match_parent"
            android:text="@string/arc_widget_name" />

        <TextView
            android:id="@+id/arc_title"
            style="@style/ArcWidgetTitle"
            android:layout_marginTop="2dp"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/arc_artist"
            style="@style/ArcWidgetArtist"
            android:textSize="13sp" />

        <Chronometer
            android:id="@+id/arc_time"
            style="@style/ArcWidgetCounter"
            android:layout_width="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-8dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/arc_prev"
                style="@style/ArcWidgetSkip"
                android:contentDescription="@string/previous"
                android:src="@drawable/arc_widget_prev" />

            <FrameLayout
                android:id="@+id/arc_play"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/arc_widget_disc"
                android:contentDescription="@string/play_pause">

                <ImageView
                    android:id="@+id/arc_play_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/arc_widget_play" />
            </FrameLayout>

            <ImageView
                android:id="@+id/arc_next"
                style="@style/ArcWidgetSkip"
                android:contentDescription="@string/next"
                android:src="@drawable/arc_widget_next" />

            <ImageView
                android:id="@+id/arc_shuffle"
                style="@style/ArcWidgetSkip"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/shuffle"
                android:src="@drawable/arc_widget_shuffle" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
