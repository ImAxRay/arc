<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/arc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/arc_widget_ground"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/arc_cover"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/album_art"
            android:scaleType="centerCrop"
            android:src="@drawable/arc_widget_blank" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/arc_title"
                style="@style/ArcWidgetTitle"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/arc_artist"
                style="@style/ArcWidgetArtist"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/arc_prev"
            style="@style/ArcWidgetSkip"
            android:contentDescription="@string/previous"
            android:src="@drawable/arc_widget_prev" />

        <FrameLayout
            android:id="@+id/arc_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/arc_widget_disc"
            android:contentDescription="@string/play_pause">

            <ImageView
                android:id="@+id/arc_play_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/arc_widget_play" />
        </FrameLayout>

        <ImageView
            android:id="@+id/arc_next"
            style="@style/ArcWidgetSkip"
            android:contentDescription="@string/next"
            android:src="@drawable/arc_widget_next" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/arc_line"
        style="@style/ArcWidgetLine"
        android:layout_gravity="bottom"
        android:layout_marginBottom="2dp" />
</FrameLayout>
